# Copy this file to ".env" and fill in the values:  cp .env.example .env
# ".env" is git-ignored — never commit real secrets.

# ---- Database (local dev defaults — safe to keep as-is) ----
# DB_HOST must match the service name in docker-compose.yml (mariadb).
DB_HOST=mariadb
DB_USER=root
DB_PASSWORD=password
DB_NAME=wash_world

# ---- Flask / JWT ----
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-long-random-string-here

# ---- Email (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use your OWN Gmail + App Password (Google Account -> Security -> App passwords),
# or get the shared team values from your password manager.
SENDER_EMAIL=your-email@gmail.com
SENDER_EMAIL_PASSWORD=your-gmail-app-password

# ---- Frontend (CORS) ----
FRONTEND_URL=http://localhost:3001
