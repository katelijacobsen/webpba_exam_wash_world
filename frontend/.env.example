# Copy this file to ".env" and fill in the values:  cp .env.example .env
# ".env" is git-ignored. NEXT_PUBLIC_* values are bundled into the browser —
# never put a real secret behind a NEXT_PUBLIC_ name.

# ---- Exposed to the browser (NEXT_PUBLIC_*) ----
NEXT_PUBLIC_BACKEND_URL=http://localhost
# Public Mapbox token (it ships to the browser anyway). Restrict it by URL in your Mapbox account.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.mapbox-token-example

# ---- Server-side only (NOT exposed to the browser) ----
BACKEND_INTERNAL_URL=http://host.docker.internal
FLASK_SERVER_SIDE_ONLY=http://host.docker.internal
